#!/bin/sh /etc/rc.common
# shellcheck disable=SC3043,SC2034  # BusyBox ash has local; rc.common reads the variables
# mudi-volte: VoLTE calls on the GL.iNet Mudi 7 through SIP phones on its Wi-Fi.
# Builds the daemon's JSON config from UCI (/etc/config/mudi-volte) and runs
# mudi-imsd in service mode under procd.

START=99
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="json"
EXTRA_HELP="	json	Print the daemon configuration built from UCI (contains passwords)"

PROG=/usr/sbin/mudi-imsd
RUNDIR=/var/run/mudi-volte
CONF=$RUNDIR/imsd.json
LOG=/var/log/mudi-volte.log

. /usr/share/libubox/jshn.sh

add_list() { # name values...
	local name=$1 v
	shift
	json_add_array "$name"
	for v in "$@"; do json_add_string "" "$v"; done
	json_close_array
}

add_phone() {
	local user password ext
	config_get user "$1" user
	config_get password "$1" password
	config_get ext "$1" ext
	[ -n "$user" ] && [ -n "$password" ] || return 0
	json_add_object ""
	json_add_string user "$user"
	json_add_string password "$password"
	[ -n "$ext" ] && json_add_string ext "$ext"
	json_close_object
	PHONES=$((PHONES + 1))
}

# config_list_foreach callback: collect VALUE VARNAME appends VALUE to VARNAME.
collect() { eval "$2=\"\${$2} \$1\""; }

add_allow() { json_add_string "" "$1"; }

# spool_dir NAME: a directory of GL's smsd spool from its config, which the
# smstools3 service writes at boot; the stock path until then.
spool_dir() {
	local d
	d=$(sed -n "s/^$1 *= *\(\/.*\)/\1/p" /tmp/smstools.cfg 2>/dev/null | head -n 1)
	echo "${d:-/etc/spool/sms/$1}"
}

build_config() {
	local incoming dial country codecs ring_sec echo_ext listen port tls_port provision_port log_level
	local push_login push_password push_url push_domain ipsec_tool
	config_get incoming main incoming all
	config_get dial main dial '*'
	config_get country main country ''
	config_get codecs main codecs 'G722 PCMU PCMA'
	config_get ring_sec main ring_sec 45
	config_get echo_ext main echo_ext 600
	config_get listen main listen ''
	config_get port main port 5060
	config_get provision_port main provision_port 8060
	config_get log_level main log_level info
	config_get_bool SMS main sms 1
	config_get_bool ENCRYPTION main encryption 1
	config_get_bool PLAIN main plain 1
	# Without TLS the plain ports are all there is.
	[ "$ENCRYPTION" = 1 ] || PLAIN=1
	config_get tls_port main tls_port 5061
	config_get push_login main push_login ''
	config_get push_password main push_password ''
	config_get push_url main push_url ''
	config_get push_domain main push_domain ''
	config_get ipsec_tool main ipsec_tool ''
	PCSCF=''
	config_list_foreach main pcscf collect PCSCF
	[ -n "$listen" ] || listen=$(uci -q get network.lan.ipaddr)
	listen=${listen%%/*}

	json_init
	json_add_string mode service
	json_add_string log_level "$log_level"
	json_add_string log_file "$LOG"
	if [ "$incoming" = allow ]; then
		json_add_boolean incoming_all 0
	else
		json_add_boolean incoming_all 1
	fi
	json_add_array allow
	config_list_foreach main allow add_allow
	json_close_array
	# shellcheck disable=SC2086
	[ -n "$PCSCF" ] && add_list pcscf $PCSCF
	[ -n "$ipsec_tool" ] && json_add_string ipsec_tool "$ipsec_tool"
	json_add_string state_file "$RUNDIR/state.json"
	json_add_string phones_file "$RUNDIR/phones.json"
	json_add_string sms_inbox /etc/mudi-volte/sms-inbox.jsonl
	json_add_string missed_calls /etc/mudi-volte/missed.jsonl
	if [ "$SMS" = 1 ]; then
		json_add_object sms
		json_add_string incoming "$(spool_dir incoming)"
		json_add_string outgoing "$(spool_dir outgoing)"
		json_add_string sent "$(spool_dir sent)"
		json_add_string failed "$(spool_dir failed)"
		json_add_string state_file /etc/mudi-volte/sms-phones.json
		json_close_object
	fi

	json_add_object sip
	json_add_string listen "$listen:$port"
	if [ "$ENCRYPTION" = 1 ]; then
		if [ "$PLAIN" = 1 ]; then
			add_list transports udp tcp tls
		else
			add_list transports tls
		fi
		json_add_int tls_port "$tls_port"
		json_add_string tls_cert_file /etc/mudi-volte/tls.crt
		json_add_string tls_key_file /etc/mudi-volte/tls.key
	else
		add_list transports udp tcp
	fi
	PHONES=0
	json_add_array accounts
	config_foreach add_phone phone
	json_close_array
	# shellcheck disable=SC2086
	add_list codecs $codecs
	set -f
	# shellcheck disable=SC2086
	add_list dial_allow $dial
	set +f
	json_add_string default_country "$country"
	json_add_string echo_ext "$echo_ext"
	json_add_int ring_sec "$ring_sec"
	json_add_int provision_port "$provision_port"
	json_add_string provision_key_file /etc/mudi-volte/provision.key
	if [ -n "$push_login" ]; then
		json_add_object push
		json_add_string login "$push_login"
		json_add_string password "$push_password"
		[ -n "$push_url" ] && json_add_string url "$push_url"
		[ -n "$push_domain" ] && json_add_string domain "$push_domain"
		json_close_object
	fi
	json_close_object
	json_dump
}

# json: the daemon configuration for 'mudi-volte phone show' (QR links), also
# when the service is stopped. (Not "config": /lib/functions.sh owns that name.)
json() {
	config_load mudi-volte
	umask 077
	build_config
}

start_service() {
	local enabled
	config_load mudi-volte
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		echo "mudi-volte is not set up yet: run 'mudi-volte setup'" >&2
		return 0
	fi
	mkdir -p "$RUNDIR" /etc/mudi-volte
	chmod 700 /etc/mudi-volte
	umask 077
	build_config > "$CONF.tmp" || return 1
	if [ "$PHONES" = 0 ]; then
		echo "mudi-volte: no phones configured: run 'mudi-volte phone add NAME'" >&2
		rm -f "$CONF.tmp"
		return 1
	fi
	mv "$CONF.tmp" "$CONF"
	# SMS to the phones off: turned on again later, the phones get only the SMS
	# that come after that.
	[ "$SMS" = 1 ] || rm -f /etc/mudi-volte/sms-phones.json

	local zone
	zone=$(uci -q get system.@system[0].zonename | tr ' ' '_')

	procd_open_instance
	procd_set_param command "$PROG" -mode service -config "$CONF"
	# Log times in the router's time zone (the daemon carries the zone database).
	[ -n "$zone" ] && procd_set_param env TZ="$zone"
	# Restart forever, 10 s apart; the daemon itself recovers the IMS side.
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	# de-REGISTER and data-call teardown need a few seconds.
	procd_set_param term_timeout 30
	procd_set_param file /etc/config/mudi-volte
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mudi-volte
}
